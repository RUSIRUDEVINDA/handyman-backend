{
  "info": {
    "name": "Handyman Backend API",
    "description": "Manual Postman collection for the Handyman Backend API. Run Health, Auth, profile, booking, then payment requests in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "customer_token",
      "value": ""
    },
    {
      "key": "handyman_token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "booking_id",
      "value": ""
    },
    {
      "key": "payment_id",
      "value": ""
    },
    {
      "key": "handyman_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/v1/auth/register customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@test.com\",\n  \"password\": \"password123\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/register"
          }
        },
        {
          "name": "POST /api/v1/auth/register handyman",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('handyman_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"handyman@test.com\",\n  \"password\": \"password123\",\n  \"role\": \"HANDYMAN\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/register"
          }
        },
        {
          "name": "POST /api/v1/auth/login customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) pm.collectionVariables.set('customer_token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "POST /api/v1/auth/login handyman",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) pm.collectionVariables.set('handyman_token', body.token);",
                  "if (body.user && body.user.id) pm.collectionVariables.set('handyman_id', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"handyman@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Profiles",
      "item": [
        {
          "name": "PUT /api/v1/customers/me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Test Customer\",\n  \"phone\": \"+94770000000\",\n  \"address\": \"Colombo\"\n}"
            },
            "url": "{{base_url}}/api/v1/customers/me"
          }
        },
        {
          "name": "GET /api/v1/customers/me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{base_url}}/api/v1/customers/me"
          }
        },
        {
          "name": "PUT /api/v1/handymen/me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{handyman_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Test Handyman\",\n  \"phone\": \"+94771111111\",\n  \"bio\": \"General repairs and plumbing\",\n  \"skills\": [\"plumbing\", \"electrical\"],\n  \"hourly_rate\": 2500,\n  \"status\": \"AVAILABLE\"\n}"
            },
            "url": "{{base_url}}/api/v1/handymen/me"
          }
        },
        {
          "name": "GET /api/v1/handymen?skill=plumbing",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/handymen?skill=plumbing"
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "POST /api/v1/bookings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('booking_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_name\": \"Plumbing repair\",\n  \"notes\": \"Kitchen sink leak\",\n  \"amount_cents\": 500000\n}"
            },
            "url": "{{base_url}}/api/v1/bookings"
          }
        },
        {
          "name": "GET /api/v1/bookings",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{base_url}}/api/v1/bookings"
          }
        },
        {
          "name": "PUT /api/v1/bookings/:id/approve",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{handyman_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "url": "{{base_url}}/api/v1/bookings/{{booking_id}}/approve"
          }
        },
        {
          "name": "PUT /api/v1/bookings/:id/start",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{handyman_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "url": "{{base_url}}/api/v1/bookings/{{booking_id}}/start"
          }
        },
        {
          "name": "PUT /api/v1/bookings/:id/complete",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{handyman_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "url": "{{base_url}}/api/v1/bookings/{{booking_id}}/complete"
          }
        }
      ]
    },
    {
      "name": "Locations",
      "item": [
        {
          "name": "PUT /api/v1/locations/me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{handyman_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 6.9271,\n  \"lng\": 79.8612\n}"
            },
            "url": "{{base_url}}/api/v1/locations/me"
          }
        },
        {
          "name": "GET /api/v1/locations/nearby",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/locations/nearby?lat=6.9271&lng=79.8612&radius_km=10"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "POST /api/v1/payments/payhere/checkout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.payment && body.payment.id) pm.collectionVariables.set('payment_id', body.payment.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{handyman_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": \"{{booking_id}}\",\n  \"amount_cents\": 500000,\n  \"currency\": \"LKR\",\n  \"items\": \"Plumbing repair\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"Customer\",\n  \"email\": \"customer@test.com\",\n  \"phone\": \"0770000000\",\n  \"address\": \"Colombo\",\n  \"city\": \"Colombo\",\n  \"country\": \"Sri Lanka\"\n}"
            },
            "url": "{{base_url}}/api/v1/payments/payhere/checkout",
            "description": "Returns PayHere sandbox action_url and form fields. The frontend should submit these fields as an HTML form POST to action_url."
          }
        },
        {
          "name": "POST /api/v1/payments/cash",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('payment_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": \"{{booking_id}}\",\n  \"amount_cents\": 500000,\n  \"currency\": \"LKR\"\n}"
            },
            "url": "{{base_url}}/api/v1/payments/cash"
          }
        },
        {
          "name": "PUT /api/v1/payments/cash/:payment_id/collected",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "url": "{{base_url}}/api/v1/payments/cash/{{payment_id}}/collected"
          }
        },
        {
          "name": "GET /api/v1/payments/bookings/:booking_id",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{base_url}}/api/v1/payments/bookings/{{booking_id}}"
          }
        },
        {
          "name": "POST /api/v1/payments/payhere/notify",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "merchant_id",
                  "value": "122XXXX",
                  "type": "text"
                },
                {
                  "key": "order_id",
                  "value": "{{payment_id}}",
                  "type": "text"
                },
                {
                  "key": "payment_id",
                  "value": "SANDBOX_PAYMENT_ID",
                  "type": "text"
                },
                {
                  "key": "payhere_amount",
                  "value": "5000.00",
                  "type": "text"
                },
                {
                  "key": "payhere_currency",
                  "value": "LKR",
                  "type": "text"
                },
                {
                  "key": "status_code",
                  "value": "2",
                  "type": "text"
                },
                {
                  "key": "md5sig",
                  "value": "GENERATED_BY_PAYHERE",
                  "type": "text"
                }
              ]
            },
            "url": "{{base_url}}/api/v1/payments/payhere/notify",
            "description": "This endpoint verifies PayHere's md5sig. A fake md5sig will be rejected. For real sandbox testing, use a public tunnel for APP_BASE_URL so PayHere can call this notify URL."
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "POST /api/v1/reviews",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": \"{{booking_id}}\",\n  \"handyman_id\": \"{{handyman_id}}\",\n  \"rating\": 5,\n  \"comment\": \"Great service.\"\n}"
            },
            "url": "{{base_url}}/api/v1/reviews"
          }
        },
        {
          "name": "GET /api/v1/reviews/handymen/:handyman_id",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/reviews/handymen/{{handyman_id}}"
          }
        }
      ]
    },
    {
      "name": "Dashboards",
      "item": [
        {
          "name": "GET /api/v1/dashboards/customer",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{base_url}}/api/v1/dashboards/customer"
          }
        },
        {
          "name": "GET /api/v1/dashboards/handyman",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{handyman_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{base_url}}/api/v1/dashboards/handyman"
          }
        },
        {
          "name": "GET /api/v1/dashboards/admin",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{base_url}}/api/v1/dashboards/admin",
            "description": "Requires an ADMIN token. Create an admin by updating a user role in Supabase, then login and place that token in the admin_token collection variable."
          }
        }
      ]
    }
  ]
}
